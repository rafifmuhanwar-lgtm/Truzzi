# ── Engine & server ──
DATA_ENGINE=postgres          # postgres | appwrite | demo
STORAGE_ENGINE=local          # local (folder) | appwrite
PORT=4000
WEB_ORIGIN=http://localhost:5173

# ── Database PostgreSQL ──
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/sentraxgo_web?schema=public"

# ── Google OAuth (engine postgres) ──
# Buat di https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client ID (Web)
# Redirect URI: http://localhost:5173/#/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Session / JWT ──
JWT_SECRET=sentraxgo-dev-secret-change-me
SESSION_COOKIE_NAME=sg_session

# ── Appwrite (hanya bila DATA_ENGINE=appwrite) ──
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6a5a2ab80012a3e5860a
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=6a5a2cca002aaa8dd6f8
APPWRITE_STORAGE_BUCKET_ID=6a5d565700192c93077a
APPWRITE_USERS_COLLECTION=users
APPWRITE_ORDERS_COLLECTION=orders
APPWRITE_CHATS_COLLECTION=chats
APPWRITE_COURIERS_COLLECTION=couriers
APPWRITE_NOTIFICATIONS_COLLECTION=notifications
APPWRITE_ADDRESSES_COLLECTION=addresses
APPWRITE_PAYMENT_METHODS_COLLECTION=payment_methods
APPWRITE_PROMOS_COLLECTION=promos
APPWRITE_WALLETS_COLLECTION=sentrapay_wallets
APPWRITE_ESCROWS_COLLECTION=escrow_transactions
APPWRITE_TOPUPS_COLLECTION=topup_transactions

# ── Payment gateway: buatqris | pakasir | demo ──
PAYMENT_PROVIDER=buatqris

# BuatQris (https://buatqris.site) — dapat dari dashboard
BUATQRIS_BASE_URL=https://api.buatqris.site
BUATQRIS_APP_BASE_URL=https://app.buatqris.site
BUATQRIS_ACCOUNT_ID=
BUATQRIS_SECRET_TOKEN=
BUATQRIS_SIGNING_SECRET=
BUATQRIS_SANDBOX=1   # 1 = mode test (test=1 + test_pay); 0 = live

# ── Pakasir QRIS (alternatif) ──
PAKASIR_BASE_URL=https://app.pakasir.com
PAKASIR_PROJECT_SLUG=sentraxgo
PAKASIR_API_KEY=

# ── Mapbox (kosong → OSM/OSRM fallback) ──
MAPBOX_ACCESS_TOKEN=