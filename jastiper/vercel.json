{
  "rewrites": [
    { "source": "/wilayah/:path*", "destination": "https://wilayah.id/:path*" },
    { "source": "/api/:path*", "destination": "https://api-truzzi.vercel.app/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://api-truzzi.vercel.app/uploads/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
